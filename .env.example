DB_PASSWORD=analog
DATABASE_URL=postgresql://postgres:analog@localhost:5434/analog

# auto = live with the key; cache (kept answers only) and off (rules only) are for evaluation and tests
ANALOG_LLM=auto
# the model and the query's vector; without it — rules and kept answers only; never commit a real key
OPENROUTER_API_KEY=
# embeddings model (OpenRouter now, the same open model run locally in production)
# ANALOG_EMBEDDING_MODEL=baai/bge-m3
