flowchart TB
    classDef code fill:#dbeafe,stroke:#2563eb,color:#111
    classDef ai fill:#f3e8ff,stroke:#9333ea,color:#111
    classDef data fill:#fef9c3,stroke:#ca8a04,color:#111
    classDef human fill:#dcfce7,stroke:#16a34a,color:#111
    classDef side fill:#f8fafc,stroke:#94a3b8,color:#334155

    Q(["Запрос: кабель КВВГнг-LS 7*1.5"])
    BAD["Пустой или > 500 символов → ошибка"]:::side
    Q -.-> BAD

    subgraph R4["4 · Разбор запроса"]
        direction LR
        C4["Категория по ключевым словам<br/>кабель контрольный"]:::code
        AC4["Категорию не узнали («бесперебойник»)<br/>→ ИИ выбирает из 8 похожих"]:::ai
        F4["Характеристики по правилам<br/>7 жил · 1,5 мм² · нг-LS"]:::code
        AF4["Значение не распознали («семь жил»)<br/>→ ИИ выбирает из списка"]:::ai
        U4["Пользователь может поправить"]:::human
        C4 -.-> AC4
        C4 --> F4 --> U4
        F4 -.-> AF4
    end

    subgraph R5["5 · Отбор кандидатов"]
        direction LR
        S5["Вся категория: 26<br/>+ 20 по написанию + 20 по смыслу"]:::code
        FO5["Чужие категории — тоже<br/>по характеристикам запроса"]:::code
        NC5["Нет категории → только<br/>40 похожих, по тексту"]:::side
        DB[("База из 1.1")]:::data
        DB --> S5 --> FO5
        S5 ~~~ NC5
    end

    subgraph R6["6 · Правила и балл"]
        direction LR
        RU[("Правила замен")]:::data
        S6["Сравнение характеристик<br/>точно · не хуже · ±1 ступень"]:::code
        X6["Обязательная не совпала → отсев<br/>прочая → штраф"]:::code
        K6["ТА ЖЕ · АНАЛОГ · НЕ ПРОВЕРЕНО<br/>осталось 2"]:::code
        SC6["Балл: текст 0,35 ·<br/>характеристики 0,45 · категория 0,2"]:::code
        RU --> S6 --> X6 --> K6 --> SC6
    end

    subgraph R7["7 · Золотая карточка"]
        direction LR
        GC[("Карточки")]:::data
        S7["«та же», «аналог» → наверх<br/>«не подходит» → убрать"]:::code
        M7["Не найдена поиском → добавить"]:::code
        GC --> S7 --> M7
    end

    subgraph R8["8 · Порог и ИИ"]
        direction LR
        P8["Балл ≥ 0,5<br/>(отмеченные — всегда)"]:::code
        OK8["ТА ЖЕ, АНАЛОГ → без ИИ"]:::code
        AI8["НЕ ПРОВЕРЕНО, по тексту<br/>→ ИИ: аналог или другое"]:::ai
        V8["«другое» → убрать<br/>не уверен → как было"]:::code
        P8 --> OK8
        P8 -.-> AI8 --> V8
    end

    subgraph R9["Выдача"]
        direction LR
        OUT["До 5 строк<br/>+ чем отличается"]
        UV["Только НЕ ПРОВЕРЕНО<br/>→ «проверьте вручную»"]:::side
        NF["Никого → НЕ НАЙДЕНО<br/>+ причина и ближайшая строка"]:::side
        OUT ~~~ UV ~~~ NF
    end

    S9["9 · Специалист отмечает → золотая карточка"]:::human

    Q --> R4
    R4 --> R5
    R5 --> R6 --> R7 --> R8 --> R9 --> S9
